#: src/Commerce/Admin/Settings.php:392
msgid "Show carbohydrates (g)"
msgstr "Mostrar carbohidratos (g)"

#: src/Commerce/Admin/Settings.php:394
msgid "Show protein (g)"
msgstr "Mostrar proteínas (g)"

#: src/Commerce/Admin/Settings.php:396
