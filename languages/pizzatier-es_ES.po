msgstr "Panel — debajo del configurador (requiere integración con el tema)"

#: src/Commerce/Admin/Settings.php:386
msgid "Show running nutrition totals"
msgstr "Mostrar totales nutricionales acumulados"

#: src/Commerce/Admin/Settings.php:387
