msgid "Cart & Checkout"
msgstr "Carrito y pago"

#: src/Commerce/Admin/Settings.php:338
msgid "Cart item name template"
msgstr "Plantilla de nombre de artículo del carrito"

#: src/Commerce/Admin/Settings.php:339
msgid ""
"Customise the product name in cart/order. Tokens: {product}, {size}, "
"{topping_count}, {crust}, {sauce}. E.g. \"{product} — {size}\". Leave blank "
"for default product name."
msgstr ""

#: src/Commerce/Admin/Settings.php:340
msgid "Order note template"
msgstr "Plantilla de nota de pedido"

#: src/Commerce/Admin/Settings.php:341
msgid ""
"Auto-add a note to each pizza order. Tokens: {size}, {toppings}, {crust}, "
"{sauce}, {cheese}, {total}. Leave blank to disable."
msgstr ""
"Añadir automáticamente una nota a cada pedido de pizza. Tokens: {size}, "
"{toppings}, {crust}, {sauce}, {cheese}, {total}. Déjalo en blanco para "
"desactivar."

